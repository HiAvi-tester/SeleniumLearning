<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Hybrid Framework Suite" parallel="methods" thread-count="3" data-provider-thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <test name="API Tests">
        <classes>
            <class name="com.framework.tests.ProductApiTest"/>
            <class name="com.framework.tests.AccountApiTest"/>
        </classes>
    </test>

    <test name="UI + Hybrid Tests">
        <classes>
            <class name="com.framework.tests.HybridCheckoutTest"/>
            <class name="com.framework.tests.LoginNegativeTest"/>
        </classes>
    </test>
</suite>
